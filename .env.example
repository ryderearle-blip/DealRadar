# Server-only retailer credentials. Never expose these with a NEXT_PUBLIC_ prefix.
BEST_BUY_API_KEY=

# Replace the working wordmark without editing app components.
NEXT_PUBLIC_BRAND_PRIMARY=Deal
NEXT_PUBLIC_BRAND_ACCENT=Radar

# These retailers require approved partner access before their price feeds can be enabled.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_PARTNER_TAG=
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# eBay Buy Browse API. Keep credentials server-only.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_US

# Optional privacy-safe operational event collector. The app never sends searches,
# ZIP codes, coordinates, names, prices, URLs, or error messages to this endpoint.
OBSERVABILITY_ENDPOINT=
OBSERVABILITY_TOKEN=
